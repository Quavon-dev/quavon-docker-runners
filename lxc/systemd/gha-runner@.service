[Unit]
Description=GitHub Actions runner %i (Docker)
Documentation=https://docs.github.com/actions/hosting-your-own-runners
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
ExecStart=/usr/local/lib/gha-runners/run-container.sh %i
ExecStop=/usr/bin/docker stop --time 60 gha-%i
Restart=always
RestartSec=10
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target
